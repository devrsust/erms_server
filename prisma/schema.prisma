// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgres"
}

model Template {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  content String? @db.Text
  logo    String?

  createdBy Int
  creator   User @relation("TemplateCreator", fields: [createdBy], references: [id])

  users User[] @relation("TemplateUsers")

  requests Request[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  // Relations
  users  User[]
  Alumni Alumni[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Alumni {
  id            Int       @id @default(autoincrement())
  firstname     String
  lastname      String
  middlename    String?
  email         String    @unique
  matric_number String    @unique
  gender        String?
  date_of_birth DateTime?
  phone_number  String?
  address       String?
  password      String?

  // Foreign Key
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id], onDelete: Restrict)

  refresh_token        String?
  refresh_token_expiry DateTime?
  last_login           DateTime?
  isActive             Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  data                 Json?

  // Relations
  requests Request[]
  payments Payment[]

  // Indexes
  @@index([email])
  @@index([matric_number])
  @@index([roleId])
  @@index([isActive])
}

model User {
  id                   Int       @id @default(autoincrement())
  firstname            String
  lastname             String
  email                String    @unique
  password             String
  isActive             Boolean   @default(true)
  refresh_token        String?
  refresh_token_expiry DateTime?
  last_login           DateTime?

  // Image Keys
  signature         String?
  stamp             String?
  signaturePublicId String?
  stampPublicId     String?

  // Foreign Key
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  documents        Document[]
  faculty          Faculty[]
  departments      Department[]
  combo            Combo[]
  approvals        Approval[]
  comments         Comment[]
  approvalChains   ApprovalChain[] @relation("UserCreatedChains")
  createdTemplates Template[]      @relation("TemplateCreator")
  templates        Template[]      @relation("TemplateUsers")

  // Indexes
  @@index([email])
  @@index([roleId])
  @@index([isActive])
}

model Document {
  id            Int     @id @default(autoincrement())
  title         String  @unique
  description   String?
  status        String  @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED
  price         Int     @default(0)
  processingFee Int     @default(0)
  totalAmount   Int     @default(0)

  // Creator
  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Approval Flow
  approvalChainId Int?
  approvalChain   ApprovalChain? @relation(fields: [approvalChainId], references: [id])

  // Relations
  requests Request[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([approvalChainId])
}

model ApprovalChain {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  steps     ApprovalStep[]
  documents Document[]

  isActive Boolean @default(true)

  createdById Int
  createdBy   User @relation("UserCreatedChains", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([isActive])
}

model ApprovalStep {
  id Int @id @default(autoincrement())

  chainId Int
  chain   ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  stepOrder   Int
  name        String
  description String?

  // Approval Assignment
  roleId Int?
  userId Int?

  // Options
  canReject Boolean @default(true)

  // Relations
  currentForRequest Request[]  @relation("CurrentStep")
  approvals         Approval[]

  createdAt DateTime @default(now())

  @@unique([chainId, stepOrder])
  @@index([chainId])
  @@index([roleId])
  @@index([userId])
}

model Approval {
  id Int @id @default(autoincrement())

  requestId Int
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stepId Int
  step   ApprovalStep @relation(fields: [stepId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  action  String // APPROVE, REJECT
  comment Comment?

  createdAt DateTime @default(now())

  @@index([requestId, stepId]) 
  @@index([requestId])
  @@index([userId])
}

model Comment {
  id         Int       @id @default(autoincrement())
  content    String
  requestId  Int
  request    Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  
  approvalId Int?      @unique 
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime  @default(now())
}

model Request {
  id               Int     @id @default(autoincrement())
  type             String
  email            String?
  address          String
  reference_number String  @unique @default(cuid())
  status           String  @default("PENDING")
  pdfUrl           String?
  publicId         String?

  // Foreign Key
  userId Int?
  user   Alumni? @relation(fields: [userId], references: [id])

  facultyId Int?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  currentStepId Int?
  currentStep   ApprovalStep? @relation("CurrentStep", fields: [currentStepId], references: [id])

  documentId Int
  document   Document @relation(fields: [documentId], references: [id])

  templateId Int?
  template   Template? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  Payment[]
  approvals Approval[]
  comments  Comment[]

  // Indexes
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id               String  @id @default(cuid())
  gateway_name     String  @default("PAYSTACK")
  gateway_response Json?
  transaction_id   String? @unique
  totalAmount      Int
  email            String?
  status           String  @default("PENDING")
  reference        String? @unique
  access_code      String?

  // Foreign Key
  userId Int
  user   Alumni? @relation(fields: [userId], references: [id])

  requestId Int?
  request   Request? @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Faculty {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Audit
  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Relations
  requests    Request[]
  departments Department[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([name])
  @@index([createdById])
}

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique

  // Audit
  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Relations
  facultyId Int
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints & Indexes
  @@unique([name, facultyId])
  @@index([facultyId])
  @@index([createdById])
  @@index([name])
}

model Combo {
  id            Int    @id @default(autoincrement())
  name          String
  class         String
  matric_number String @unique
  certNo        String @unique
  type          String
  year          String
  remark        String
  session       String
  print_date    String

  // Foreign key and relation
  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id Int @id @default(autoincrement())

  action String
  entity String

  description String?

  // Polymorphic actor
  actorType String // "ALUMNI" | "USER" | "SYSTEM"
  actorId   String? // ID from either table

  meta Json?

  createdAt DateTime @default(now())

  @@index([entity])
  @@index([actorType])
  @@index([actorId])
  @@index([createdAt])
}

model Upload {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String?
  folder    String
  type      String // signature | stamp | document | etc
  userId    Int?
  createdAt DateTime @default(now())
}
